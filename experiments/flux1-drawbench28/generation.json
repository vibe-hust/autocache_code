{
  "model": "flux",
  "method": "residual_cache",
  "model_path": "models/FLUX.1-dev",
  "dtype": "bfloat16",
  "device": "cuda:0",
  "height": 1024,
  "width": 1024,
  "guidance_scale": 3.5,
  "max_sequence_length": 512,
  "reference_steps": 28,
  "metrics_python": "python",
  "metrics": {
    "names": [
      "clip_score",
      "image_reward",
      "psnr",
      "ssim",
      "lpips"
    ],
    "clip_model": "metrics/clip/checkpoints/ViT-B-32.pt",
    "image_reward_checkpoint": "metrics/image_reward/checkpoints/ImageReward.pt",
    "image_reward_config": "metrics/image_reward/checkpoints/med_config.json"
  }
}
